-- Grimdark (cold steel), shared with niri, waybar and rofi
-- bone #d8d2c4, dim #8f8a80, light steel #7aa6c4, panel #1f1f1f
-- Network monitor, bottom, left of the CPU/memory widget (conky_cpu).
-- Heading, signal bar (Wi-Fi) or link speed (wired), download/upload graphs, then details.

-- Helpers live next to this file (works from the dotfiles repo and /usr/share/conky)
local dir = debug.getinfo(1, 'S').source:match('^@(.*)/') or '/usr/share/conky'
local wayland = os.getenv('WAYLAND_DISPLAY') ~= nil
local sys = dofile(dir .. '/conky_sys.lua') -- network interface for this machine

conky.config = {
	alignment = 'bottom_right',
	gap_x = 552, -- 20 + conky_cpu (480 + 2 * 16 margin) + 20
	gap_y = 30,
	minimum_width = 280,
	maximum_width = 280,
	background = true,
	update_interval = 1.0,
	net_avg_samples = 1,
	no_buffers = true,
	double_buffer = true,
	disable_auto_reload = true, -- a reload reopens the window on the focused output

	-- niri (Wayland) or Xfce (X11); on X11 a 'desktop' window hides behind xfdesktop
	output_backend = wayland and 'wayland' or 'x11',
	xinerama_head = tonumber(os.getenv('CONKY_HEAD')) or 0, -- X11 screen, set by start_conky_xfce
	own_window = true,
	own_window_type = wayland and 'desktop' or 'normal',
	own_window_hints = wayland and 'below' or 'undecorated,below,sticky,skip_taskbar,skip_pager',
	use_xft = true, -- X11 only; Wayland always uses fontconfig
	own_window_color = '#00000000', -- transparent; the rounded panel is drawn in Lua
	border_inner_margin = 16,

	draw_shades = false,
	draw_outline = false,
	draw_borders = false,

	lua_load = dir .. '/conky_panel.lua',
	lua_draw_hook_pre = 'panel 18,64,124,50 172,64,124,50', -- graph boxes: x,y,w,h (measured)
	draw_graph_borders = false,
	show_graph_scale = false,
	show_graph_range = false,

	default_color = 'd8d2c4', -- bone
	color1 = '8f8a80',        -- dim
	color2 = '7aa6c4',        -- light steel

	font = 'Roboto Mono:size=8',
	font1 = 'Roboto:bold:size=8',
}

-- Wi-Fi and wired differ in three spots; the bar line keeps one text line either way,
-- so the measured graph boxes stay put. NETDEV is replaced with the detected interface.
local link
if sys.wireless then
	link = {
		name = '${wireless_essid NETDEV}',
		bar = '${color2}${wireless_link_bar 5,280 NETDEV}',
		rate = '${color1}bitrate${alignr}${color1}${wireless_bitrate NETDEV}',
	}
else
	link = {
		name = 'wired',
		bar = '${color1}link${alignr}${color}${execi 600 cat /sys/class/net/NETDEV/speed} Mb/s',
		rate = '${color1}interface${alignr}${color1}NETDEV',
	}
end

-- Graph args: height,width  start-colour end-colour
conky.text = ([[
${font1}${color2}NETWORK${font}${goto 86}${color1}LINK_NAME${alignr}${addr NETDEV}
${voffset 4}LINK_BAR
${voffset 6}${downspeedgraph NETDEV 50,124 3a5566 7aa6c4}${goto 172}${upspeedgraph NETDEV 50,124 5a5650 d8d2c4}
${voffset 6}${color2}download${goto 172}${color1}upload
${voffset 6}${color1}down${alignr}${color}${downspeed NETDEV}
${color1}up${alignr}${color}${upspeed NETDEV}
${color1}total down${alignr}${color1}${totaldown NETDEV}
${color1}total up${alignr}${color1}${totalup NETDEV}
LINK_RATE
${color1}gateway${alignr}${color1}${gw_ip}
]]):gsub('LINK_NAME', link.name):gsub('LINK_BAR', link.bar):gsub('LINK_RATE', link.rate):gsub('NETDEV', sys.iface)
