-- Grimdark (cold steel), shared with niri, waybar and rofi
-- bone #d8d2c4, dim #8f8a80, light steel #7aa6c4, panel #1f1f1f
-- Clock, date and month calendar, top right. No panel: bright text straight on the wallpaper.

-- Calendar helper lives next to this file (works from the dotfiles repo and /usr/share/conky)
local dir = debug.getinfo(1, 'S').source:match('^@(.*)/') or '/usr/share/conky'
local wayland = os.getenv('WAYLAND_DISPLAY') ~= nil
-- start_conky_niri sets CONKY_CLOCK_LEFT with -a top_left: text hugs the left edge then
local ar = os.getenv('CONKY_CLOCK_LEFT') and '' or '${alignr}'

conky.config = {
	alignment = 'top_right',
	gap_x = 30,
	gap_y = 30,
	minimum_width = 260,
	maximum_width = 260,
	background = true,
	update_interval = 1.0,
	double_buffer = true,
	disable_auto_reload = true, -- a reload reopens the window on the focused output

	-- niri (Wayland) or Xfce (X11); on X11 a 'desktop' window hides behind xfdesktop
	output_backend = wayland and 'wayland' or 'x11',
	out_to_wayland = wayland, out_to_x = not wayland, -- conky 1.24 and older name these instead of output_backend
	xinerama_head = tonumber(os.getenv('CONKY_HEAD')) or 0, -- X11 screen, set by start_conky_xfce
	own_window = true,
	own_window_type = wayland and 'desktop' or 'normal',
	own_window_hints = wayland and 'below' or 'undecorated,below,sticky,skip_taskbar,skip_pager',
	use_xft = true, -- X11 only; Wayland always uses fontconfig
	own_window_color = '#00000000', -- fully transparent
	own_window_colour = '#00000000', -- conky 1.24 and older spell it this way
	border_inner_margin = 0,

	draw_shades = false,
	draw_outline = false,
	draw_borders = false,

	default_color = 'efeae0', -- bright bone
	color1 = 'bdb7ab',        -- soft bone (dim is too faint here)
	color2 = '9cc4de',        -- brighter steel

	font = 'Roboto Mono:medium:size=9',
	font1 = 'Roboto:light:size=58',
	font2 = 'Roboto:size=13',

	lua_load = dir .. '/conky_calendar.lua',
}

conky.text = [[
]] .. ar .. [[${font1}${color}${time %H:%M}${font}
${voffset 2}]] .. ar .. [[${font2}${color}${time %A}${color1}  ${time %-d %B %Y}${font}
${voffset 14}${lua_parse calendar}
]]
