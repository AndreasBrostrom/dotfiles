-- Grimdark (cold steel), shared with niri, waybar and rofi
-- bone #d8d2c4, dim #8f8a80, light steel #7aa6c4, panel #1f1f1f
-- System info, bottom left (top right on the office's standing screen, see start_conky_niri):
-- neofetch-ish user@host header, then two columns of sections in the monitor's style.
-- Static machine info comes from conky_niri_sys.lua; changing values use execi with long intervals.

-- Helpers live next to this file (works from the dotfiles repo and /usr/share/conky)
local dir = debug.getinfo(1, 'S').source:match('^@(.*)/') or '/usr/share/conky'
local sys = dofile(dir .. '/conky_niri_sys.lua') -- what this machine is and has

conky.config = {
	alignment = 'bottom_left',
	gap_x = 20,
	gap_y = 30,
	minimum_width = 500,
	maximum_width = 500,
	background = true,
	update_interval = 5.0,
	double_buffer = true,
	disable_auto_reload = true, -- a reload reopens the window on the focused output

	output_backend = 'wayland',
	own_window = true,
	own_window_type = 'desktop',
	own_window_hints = 'below',
	own_window_color = '#00000000', -- transparent; the rounded panel is drawn in Lua
	border_inner_margin = 16,

	draw_shades = false,
	draw_outline = false,
	draw_borders = false,

	lua_load = dir .. '/conky_niri_panel.lua',
	lua_draw_hook_pre = 'panel',

	default_color = 'd8d2c4', -- bone
	color1 = '8f8a80',        -- dim
	color2 = '7aa6c4',        -- light steel
	color3 = 'c4857a',        -- warning (muted rust)

	font = 'Roboto Mono:size=8',
	font1 = 'Roboto:bold:size=8',
	font2 = 'Roboto:light:size=18',
}

-- Columns: left label 0 / value 80, right label 280 / value 365
-- Memory, disk, battery and CPU temp are left out: the monitor and waybar already show them

-- Static strings go straight into the conky text, so escape conky's $ and #
local function esc(s)
	return (s:gsub('%$', '$$$$'):gsub('#', '\\#'))
end

local function row(label, value)
	return { label = label, value = value }
end

-- Join two columns of rows into conky lines; a missing side is left blank
local function columns(left, right)
	local lines = {}
	for i = 1, math.max(#left, #right) do
		local line = ''
		if left[i] then
			line = '${color1}' .. left[i].label .. '${goto 80}${color}' .. left[i].value
		end
		if right[i] then
			line = line .. '${goto 280}${color1}' .. right[i].label .. '${goto 365}${color}' .. right[i].value
		end
		lines[#lines + 1] = line
	end
	return table.concat(lines, '\n')
end

local pkgver = "| cut -d' ' -f2 | sed 's/^[0-9]*://; s/[+-].*//'"

local system = {
	row('kernel', '${kernel}${if_match "${kernel}" != "${execi 600 pacman -Q linux | cut -d\' \' -f2 | sed \'s/\\.arch/-arch/\'}"}${color3} reboot${endif}'),
	row('host', esc(sys.host)),
	row('bios', esc(sys.bios)),
	row('shell', '${execi 86400 getent passwd $USER | cut -d: -f7 | xargs basename}'),
	row('terminal', 'kitty'),
	row('boot', "${execi 86400 systemd-analyze | head -1 | sed 's/.*= //'}"),
}

local packages = {
	row('installed', '${execi 600 pacman -Qq | wc -l}${color1} (${execi 600 pacman -Qqe | wc -l} expl)'),
	row('updates', '${execi 3600 checkupdates 2>/dev/null | wc -l}${color1} pending'),
	row('upgraded', "${execi 600 grep 'starting full system upgrade' /var/log/pacman.log | tail -1 | cut -c2-17 | tr T ' '}"),
	row('firmware', "${execi 3600 pacman -Q linux-firmware | cut -d' ' -f2 | sed 's/-.*//'}"),
	row('mesa', '${execi 3600 pacman -Q mesa ' .. pkgver .. '}'),
	row('systemd', '${execi 3600 pacman -Q systemd ' .. pkgver .. '}'),
}

local hardware = {
	row('cpu', esc(sys.cpu)),
	row('gpu', esc(sys.gpu)),
	row('cores', sys.cores .. '${color1} cores, ${color}' .. sys.threads .. '${color1} threads'),
}
if sys.gpu_temp ~= '' then hardware[#hardware + 1] = row('gpu temp', sys.gpu_temp) end
if sys.display ~= '' then hardware[#hardware + 1] = row('display', esc(sys.display)) end

-- Only list toolchains that are installed on this machine
local dev = {}
for _, tool in ipairs({
	{ 'python', 'python', "python --version | cut -d' ' -f2" },
	{ 'gcc', 'gcc', 'gcc -dumpfullversion' },
	{ 'rust', 'rustc', "rustc --version | cut -d' ' -f2" },
	{ 'go', 'go', "go version | cut -d' ' -f3 | sed 's/^go//'" },
	{ 'node', 'node', 'node --version | tr -d v' },
	{ 'java', 'java', "java -version 2>&1 | head -1 | cut -d'\"' -f2" },
	{ 'docker', 'docker', "docker --version | cut -d' ' -f3 | tr -d ,"},
	{ 'claude', 'claude', "claude --version | cut -d' ' -f1" },
}) do
	if sys.has(tool[2]) then dev[#dev + 1] = row(tool[1], '${execi 3600 ' .. tool[3] .. '}') end
end

conky.text = [[
${font2}${color2}${execi 86400 whoami}${color1}@${color}${nodename}${font}
${voffset 2}${color1}${execi 86400 sh -c '. /etc/os-release; echo "$NAME"'} ${machine}  ·  niri ${execi 3600 niri --version | cut -d' ' -f2}  ·  up ${uptime_short}
${voffset 12}${font1}${color2}SYSTEM${font}${goto 280}${font1}${color2}PACKAGES${font}
${voffset 4}]] .. columns(system, packages) .. [[

${voffset 12}${font1}${color2}HARDWARE${font}${goto 280}${font1}${color2}DEV${font}
${voffset 4}]] .. columns(hardware, dev) .. '\n'
