-- Grimdark (cold steel), shared with niri, waybar and rofi
-- bone #d8d2c4, dim #8f8a80, light steel #7aa6c4, panel #1f1f1f
-- System info, bottom left: neofetch-ish user@host header, then two columns
-- of sections in the same style as the monitor. Slow stuff uses execi with long intervals.

-- Rounded panel helper lives next to this file (works from the dotfiles repo and /usr/share/conky)
local dir = debug.getinfo(1, 'S').source:match('^@(.*)/') or '/usr/share/conky'

conky.config = {
	alignment = 'bottom_left',
	gap_x = 20,
	gap_y = 30,
	minimum_width = 500,
	maximum_width = 500,
	background = true,
	update_interval = 5.0,
	double_buffer = true,
	disable_auto_reload = true, -- a reload reopens the window on the focused output

	output_backend = 'wayland',
	own_window = true,
	own_window_type = 'desktop',
	own_window_hints = 'below',
	own_window_color = '#00000000', -- transparent; the rounded panel is drawn in Lua
	border_inner_margin = 16,

	draw_shades = false,
	draw_outline = false,
	draw_borders = false,

	lua_load = dir .. '/conky_niri_panel.lua',
	lua_draw_hook_pre = 'panel',

	default_color = 'd8d2c4', -- bone
	color1 = '8f8a80',        -- dim
	color2 = '7aa6c4',        -- light steel
	color3 = 'c4857a',        -- warning (muted rust)

	font = 'Roboto Mono:size=8',
	font1 = 'Roboto:bold:size=8',
	font2 = 'Roboto:light:size=18',
}

-- Columns: left label 0 / value 80, right label 280 / value 365
-- Memory, disk, battery and CPU temp are left out: the monitor and waybar already show them
conky.text = [[
${font2}${color2}${execi 86400 whoami}${color1}@${color}${nodename}${font}
${voffset 2}${color1}${execi 86400 sh -c '. /etc/os-release; echo "$NAME"'} ${machine}  ·  niri ${execi 3600 niri --version | cut -d' ' -f2}  ·  up ${uptime_short}
#
${voffset 12}${font1}${color2}SYSTEM${font}${goto 280}${font1}${color2}PACKAGES${font}
${voffset 4}${color1}kernel${goto 80}${color}${kernel}${if_match "${kernel}" != "${execi 600 pacman -Q linux | cut -d' ' -f2 | sed 's/\.arch/-arch/'}"}${color3} reboot${endif}${goto 280}${color1}installed${goto 365}${color}${execi 600 pacman -Qq | wc -l}${color1} (${execi 600 pacman -Qqe | wc -l} expl)
${color1}host${goto 80}${color}${execi 86400 cat /sys/class/dmi/id/product_version}${goto 280}${color1}updates${goto 365}${color}${execi 3600 checkupdates 2>/dev/null | wc -l}${color1} pending
${color1}bios${goto 80}${color}${execi 86400 cat /sys/class/dmi/id/bios_version | cut -d' ' -f1}${goto 280}${color1}upgraded${goto 365}${color}${execi 600 grep 'starting full system upgrade' /var/log/pacman.log | tail -1 | cut -c2-17 | tr T ' '}
${color1}shell${goto 80}${color}${execi 86400 getent passwd $USER | cut -d: -f7 | xargs basename}${goto 280}${color1}firmware${goto 365}${color}${execi 3600 pacman -Q linux-firmware | cut -d' ' -f2 | sed 's/-.*//'}
${color1}terminal${goto 80}${color}kitty${goto 280}${color1}mesa${goto 365}${color}${execi 3600 pacman -Q mesa | cut -d' ' -f2 | sed 's/^[0-9]*://; s/[+-].*//'}
${color1}boot${goto 80}${color}${execi 86400 systemd-analyze | head -1 | sed 's/.*= //'}${goto 280}${color1}systemd${goto 365}${color}${execi 3600 pacman -Q systemd | cut -d' ' -f2 | sed 's/[+-].*//'}
#
${voffset 12}${font1}${color2}HARDWARE${font}${goto 280}${font1}${color2}DEV${font}
${voffset 4}${color1}cpu${goto 80}${color}${execi 86400 grep -m1 'model name' /proc/cpuinfo | sed 's/.*: //; s/ with .*//'}${goto 280}${color1}python${goto 365}${color}${execi 3600 python --version | cut -d' ' -f2}
${color1}gpu${goto 80}${color}${execi 86400 lspci | grep -m1 VGA | sed 's/.*\[//; s/\].*//'}${goto 280}${color1}gcc${goto 365}${color}${execi 3600 gcc -dumpfullversion}
${color1}cores${goto 80}${color}${execi 86400 lscpu | grep "^Core(s) per socket" | grep -o "[0-9]*"}${color1} cores, ${color}${execi 86400 nproc}${color1} threads${goto 280}${color1}rust${goto 365}${color}${execi 3600 rustc --version | cut -d' ' -f2}
${color1}gpu temp${goto 80}${color}${hwmon amdgpu temp 1}°C${goto 280}${color1}node${goto 365}${color}${execi 3600 node --version | tr -d v}
${color1}display${goto 80}${color}${execi 3600 niri msg outputs | grep -A3 "(eDP-1)" | grep "Current mode" | sed "s/.*mode: //; s/ (.*//; s/\.[0-9]* Hz/ Hz/"}${goto 280}${color1}java${goto 365}${color}${execi 3600 java -version 2>&1 | head -1 | cut -d'"' -f2}
${goto 280}${color1}claude${goto 365}${color}${execi 3600 claude --version | cut -d' ' -f1}
]]
