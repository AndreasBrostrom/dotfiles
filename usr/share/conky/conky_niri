-- Grimdark (cold steel), shared with niri, waybar and rofi
-- bone #d8d2c4, dim #8f8a80, light steel #7aa6c4, panel #1f1f1f

conky.config = {
	alignment = 'top_right',
	gap_x = 20,
	gap_y = 30,
	minimum_width = 270,
	maximum_width = 270,
	background = true,
	update_interval = 2.0,
	cpu_avg_samples = 2,
	no_buffers = true,
	double_buffer = true,
	top_name_width = 18,

	output_backend = 'wayland',
	own_window = true,
	own_window_type = 'desktop',
	own_window_hints = 'below', -- bottom layer: above the swaybg wallpaper, below windows
	own_window_color = '#d91f1f1f', -- charcoal panel, ~85% opaque (conky reads #AARRGGBB)
	border_inner_margin = 14,

	draw_shades = false,
	draw_outline = false,
	draw_borders = false,
	draw_graph_borders = false,
	default_bar_height = 3,

	default_color = 'd8d2c4', -- bone
	color1 = '8f8a80',        -- dim
	color2 = '7aa6c4',        -- light steel

	font = 'Roboto:size=9',
	font1 = 'Roboto:bold:size=8',
	font2 = 'Roboto:light:size=22',
}

conky.text = [[
${font2}${color}${nodename}${font}
${color1}${execi 86400 sh -c '. /etc/os-release; echo "$NAME"'}  ·  ${kernel}
${color1}up ${uptime_short}
#
${voffset 12}${font1}${color2}CPU${font}${color1}  ${hwmon k10temp temp 1}°C${alignr}${color}${cpu cpu0}%
${voffset 2}${color2}${cpubar cpu0}
${voffset 2}${color}${top name 1}${alignr}${color1}${top user 1}  ${color}${top cpu 1}%
${color}${top name 2}${alignr}${color1}${top user 2}  ${color}${top cpu 2}%
${color}${top name 3}${alignr}${color1}${top user 3}  ${color}${top cpu 3}%
${color}${top name 4}${alignr}${color1}${top user 4}  ${color}${top cpu 4}%
${color}${top name 5}${alignr}${color1}${top user 5}  ${color}${top cpu 5}%
${color}${top name 6}${alignr}${color1}${top user 6}  ${color}${top cpu 6}%
${color}${top name 7}${alignr}${color1}${top user 7}  ${color}${top cpu 7}%
${color}${top name 8}${alignr}${color1}${top user 8}  ${color}${top cpu 8}%
#
${voffset 12}${font1}${color2}MEMORY${font}${alignr}${color}${mem}${color1} / ${memmax}
${voffset 2}${color2}${membar}
${voffset 2}${color}${top_mem name 1}${alignr}${color1}${top_mem user 1}  ${color}${top_mem mem_res 1}
${color}${top_mem name 2}${alignr}${color1}${top_mem user 2}  ${color}${top_mem mem_res 2}
${color}${top_mem name 3}${alignr}${color1}${top_mem user 3}  ${color}${top_mem mem_res 3}
${color}${top_mem name 4}${alignr}${color1}${top_mem user 4}  ${color}${top_mem mem_res 4}
${color}${top_mem name 5}${alignr}${color1}${top_mem user 5}  ${color}${top_mem mem_res 5}
${color}${top_mem name 6}${alignr}${color1}${top_mem user 6}  ${color}${top_mem mem_res 6}
${color}${top_mem name 7}${alignr}${color1}${top_mem user 7}  ${color}${top_mem mem_res 7}
${color}${top_mem name 8}${alignr}${color1}${top_mem user 8}  ${color}${top_mem mem_res 8}
${color1}swap${alignr}${swap} / ${swapmax}
#
${voffset 12}${font1}${color2}DISK${font}${alignr}${color}${fs_used /}${color1} / ${fs_size /}
${voffset 2}${color2}${fs_bar /}
#
${voffset 12}${font1}${color2}NETWORK${font}${alignr}${color1}${wireless_essid wlan0}
${voffset 2}${color1}down ${color}${downspeed wlan0}${alignr}${color1}up ${color}${upspeed wlan0}
]]
