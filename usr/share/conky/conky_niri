-- Grimdark (cold steel), shared with niri, waybar and rofi
-- bone #d8d2c4, dim #8f8a80, light steel #7aa6c4, panel #1f1f1f
-- Clock, date and month calendar, top right. No panel: bright text straight on the wallpaper.

-- Calendar helper lives next to this file (works from the dotfiles repo and /usr/share/conky)
local dir = debug.getinfo(1, 'S').source:match('^@(.*)/') or '/usr/share/conky'

conky.config = {
	alignment = 'top_right',
	gap_x = 30,
	gap_y = 30,
	minimum_width = 260,
	maximum_width = 260,
	background = true,
	update_interval = 1.0,
	double_buffer = true,
	disable_auto_reload = true, -- a reload reopens the window on the focused output

	output_backend = 'wayland',
	own_window = true,
	own_window_type = 'desktop',
	own_window_hints = 'below',
	own_window_color = '#00000000', -- fully transparent
	border_inner_margin = 0,

	draw_shades = false,
	draw_outline = false,
	draw_borders = false,

	default_color = 'efeae0', -- bright bone
	color1 = 'bdb7ab',        -- soft bone (dim is too faint here)
	color2 = '9cc4de',        -- brighter steel

	font = 'Roboto Mono:medium:size=9',
	font1 = 'Roboto:light:size=58',
	font2 = 'Roboto:size=13',

	lua_load = dir .. '/conky_niri_calendar.lua',
}

conky.text = [[
${alignr}${font1}${color}${time %H:%M}${font}
${voffset 2}${alignr}${font2}${color}${time %A}${color1}  ${time %-d %B %Y}${font}
${voffset 14}${lua_parse calendar}
]]
