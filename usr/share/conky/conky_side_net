-- Grimdark (cold steel), shared with niri, waybar and rofi
-- bone #d8d2c4, dim #8f8a80, light steel #7aa6c4, panel #1f1f1f
-- Side screen, right edge at the bottom of the stack: network, a wider take on conky_net
-- to line up with the CPU (conky_side_cpu) and memory (conky_side_mem) widgets above it.

-- Helpers live next to this file (works from the dotfiles repo and /usr/share/conky)
local dir = debug.getinfo(1, 'S').source:match('^@(.*)/') or '/usr/share/conky'
local wayland = os.getenv('WAYLAND_DISPLAY') ~= nil
local sys = dofile(dir .. '/conky_sys.lua') -- network interface for this machine

conky.config = {
	alignment = 'top_right', -- start_conky_xfce stacks the side widgets with -y
	gap_x = 20,
	gap_y = 30,
	minimum_width = 440,
	maximum_width = 440,
	background = true,
	update_interval = 1.0,
	net_avg_samples = 1,
	no_buffers = true,
	double_buffer = true,
	disable_auto_reload = true, -- a reload reopens the window on the focused output

	-- niri (Wayland) or Xfce (X11); on X11 a 'desktop' window hides behind xfdesktop
	output_backend = wayland and 'wayland' or 'x11',
	out_to_wayland = wayland, out_to_x = not wayland, -- conky 1.24 and older name these instead of output_backend
	xinerama_head = tonumber(os.getenv('CONKY_HEAD')) or 0, -- X11 screen, set by start_conky_xfce
	own_window = true,
	own_window_type = wayland and 'desktop' or 'normal',
	own_window_hints = wayland and 'below' or 'undecorated,below,sticky,skip_taskbar,skip_pager',
	use_xft = true, -- X11 only; Wayland always uses fontconfig
	own_window_color = '#00000000', -- transparent; the rounded panel is drawn in Lua
	own_window_colour = '#00000000', -- conky 1.24 and older spell it this way
	border_inner_margin = 16,

	draw_shades = false,
	draw_outline = false,
	draw_borders = false,

	lua_load = dir .. '/conky_panel.lua',
	lua_draw_hook_pre = 'panel 18,65,210,50 248,65,210,50', -- graph boxes: x,y,w,h (measured)
	draw_graph_borders = false,
	show_graph_scale = false,
	show_graph_range = false,

	default_color = 'd8d2c4', -- bone
	color1 = '8f8a80',        -- dim
	color2 = '7aa6c4',        -- light steel

	font = 'Roboto Mono:size=8',
	font1 = 'Roboto:bold:size=8',
}

-- Wi-Fi and wired differ in three spots, same as conky_net. NETDEV is replaced with
-- the detected interface.
local link
if sys.wireless then
	link = {
		name = '${wireless_essid NETDEV}',
		bar = '${color2}${wireless_link_bar 5,440 NETDEV}',
		rate = '${color1}bitrate${goto 100}${color1}${wireless_bitrate NETDEV}',
	}
else
	link = {
		name = 'wired',
		bar = '${color1}link${alignr}${color}${execi 600 cat /sys/class/net/NETDEV/speed} Mb/s',
		rate = '${color1}interface${goto 100}${color1}NETDEV',
	}
end

-- Two columns of details under the graphs: left label 18 / value 100, right 248 / 330
-- Graph args: height,width  start-colour end-colour
conky.text = ([[
${font1}${color2}NETWORK${font}${goto 80}${color1}LINK_NAME${alignr}${addr NETDEV}
${voffset 4}LINK_BAR
${voffset 6}${downspeedgraph NETDEV 50,210 3a5566 7aa6c4}${goto 248}${upspeedgraph NETDEV 50,210 5a5650 d8d2c4}
${voffset 6}${color2}download${alignr 230}${color}${downspeed NETDEV}${goto 248}${color1}upload${alignr}${color}${upspeed NETDEV}
${voffset 6}${color1}total down${goto 100}${color}${totaldown NETDEV}${goto 248}${color1}total up${goto 330}${color}${totalup NETDEV}
LINK_RATE${goto 248}${color1}gateway${goto 330}${color1}${gw_ip}
${color1}connections${goto 100}${color}${tcp_portmon 1 65535 count}${color1} tcp${goto 248}${color1}dns${goto 330}${color1}${execi 600 grep -m1 ^nameserver /etc/resolv.conf | cut -d' ' -f2}
]]):gsub('LINK_NAME', link.name):gsub('LINK_BAR', link.bar):gsub('LINK_RATE', link.rate):gsub('NETDEV', sys.iface)
