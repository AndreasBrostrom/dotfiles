#!/bin/bash

# Restart cleanly: stop every conky of this user, also ones left from a niri or Xfce
# session or a previous login (those ignore SIGTERM, so force-kill stragglers), and
# Xfce's wait for its side screen
WAIT_PID=${XDG_RUNTIME_DIR:-/tmp}/start_conky_xfce.wait
[[ -f $WAIT_PID ]] && kill "$(cat "$WAIT_PID")" 2>/dev/null
rm -f "$WAIT_PID"
pkill -x -u "$USER" conky
sleep 0.5
pkill -9 -x -u "$USER" conky

conky -c /usr/share/conky/conky_shortcuts_i3 &&
conky -c /usr/share/conky/conky_i3 &&

exit 0