#!/bin/bash
# Start the conky widgets (clock, cpu/memory, network, info) on one screen in Xfce (X11).
# Screen: the laptop screen (eDP*) if there is one, else the primary, else the first.
# Override with an output name from `xrandr --listmonitors`, e.g. CONKY_OUTPUT=HDMI-A-0.
#
# With a second screen (home desktop), the side widgets go on it, stacked down the right
# edge: clock and calendar, CPU with every core, memory and swap, then network, plus the
# systemctl status header at its bottom left. That's the first screen that isn't the main
# one; pick it with CONKY_SIDE=<output>, or set CONKY_SIDE= (empty) to leave it out. On a
# desktop (no laptop screen) where the second screen is still off, the script waits in
# the background and starts them once it's on.
#
# Usage: start_conky_xfce [config dir]   (default /usr/share/conky)

CONF_DIR=${1:-/usr/share/conky}
CONFIGS=(conky_clock conky_cpu conky_net conky_info)
SIDE_CONFIGS=(conky_clock conky_side_cpu conky_side_mem conky_side_net)
SIDE_GAP=10 # between stacked side widgets

# "<index> <name> <primary>" per monitor, from lines like " 0: +*eDP 1920/302x1200/189+0+0  eDP"
monitors=$(xrandr --listmonitors | awk 'NR > 1 {sub(":", "", $1); print $1, $NF, ($2 ~ /\*/)}')

if [[ -n $CONKY_OUTPUT ]]; then
    pick=$(awk -v o="$CONKY_OUTPUT" '$2 == o' <<<"$monitors")
else
    pick=$(awk '$2 ~ /^eDP/' <<<"$monitors")
    [[ -z $pick ]] && pick=$(awk '$3 == 1' <<<"$monitors")
    [[ -z $pick ]] && pick=$(head -1 <<<"$monitors")
fi
read -r head output _ <<<"$pick"

# "<index> <name>" of the side screen, empty when it isn't connected (or not wanted)
side_pick() {
    if [[ -v CONKY_SIDE ]]; then
        [[ -n $CONKY_SIDE ]] && awk -v o="$CONKY_SIDE" '$2 == o' <<<"$monitors"
    else
        awk -v o="$output" '$2 != o' <<<"$monitors" | head -1
    fi
}

# Stack each side widget under the previous one, using its window's real height
# (the calendar grows a row in six-week months)
start_side() {
    local side_head side_output y=30 conf before win height last
    read -r side_head side_output _ <<<"$1"
    for conf in "${SIDE_CONFIGS[@]}"; do
        before=$(xdotool search --class conky | sort)
        CONKY_HEAD=$side_head CONKY_OUTPUT=$side_output conky -q -a top_right -x 20 -y $y -c "$CONF_DIR/$conf"
        # A new window starts tiny and grows to fit its text: wait for two equal readings
        height= last=
        for _ in $(seq 50); do
            win=$(comm -13 <(echo "$before") <(xdotool search --class conky | sort) | head -1)
            [[ -n $win ]] && height=$(xdotool getwindowgeometry --shell "$win" | sed -n 's/^HEIGHT=//p')
            [[ -n $height && $height -gt 20 && $height == "$last" ]] && break
            last=$height
            sleep 0.2
        done
        (( y += ${height:-300} + SIDE_GAP ))
    done
    # systemctl status header, bottom left of the same screen
    CONKY_HEAD=$side_head CONKY_OUTPUT=$side_output conky -q -a bottom_left -x 20 -y 30 -c "$CONF_DIR/conky_systemd"
}

# Restart cleanly: stop the wait for the side screen and every conky of this user, also
# ones left from a niri or i3 session or a previous login. Those lose their display,
# spin at 100% CPU and ignore SIGTERM, so force-kill stragglers.
WAIT_PID=${XDG_RUNTIME_DIR:-/tmp}/start_conky_xfce.wait
[[ -f $WAIT_PID ]] && kill "$(cat "$WAIT_PID")" 2>/dev/null
rm -f "$WAIT_PID"
pkill -x -u "$USER" conky
sleep 0.5
pkill -9 -x -u "$USER" conky

for conf in "${CONFIGS[@]}"; do
    CONKY_HEAD=${head:-0} CONKY_OUTPUT=$output conky -q -c "$CONF_DIR/$conf"
done

# Let the main widgets' windows show up first, so stacking doesn't measure one of them
for _ in $(seq 50); do
    (( $(xdotool search --class conky | wc -l) >= ${#CONFIGS[@]} )) && break
    sleep 0.1
done

side=$(side_pick)
if [[ -n $side ]]; then
    start_side "$side"
elif [[ ! -v CONKY_SIDE && $output != eDP* ]]; then
    (
        until [[ -n $side ]]; do
            sleep 10
            list=$(xrandr --listmonitors) || exit # display gone: logged out
            monitors=$(awk 'NR > 1 {sub(":", "", $1); print $1, $NF, ($2 ~ /\*/)}' <<<"$list")
            side=$(side_pick)
        done
        rm -f "$WAIT_PID"
        sleep 3 # let Xfce finish placing the screen
        start_side "$side"
    ) &
    echo $! >"$WAIT_PID"
fi

exit 0
